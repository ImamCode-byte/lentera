Options +FollowSymLinks
RewriteEngine On

# 1. Arahkan aset statis langsung ke frontend/web
RewriteRule ^csss/(.*)$ frontend/web/csss/$1 [L]
RewriteRule ^jss/(.*)$ frontend/web/jss/$1 [L]
RewriteRule ^imgs/(.*)$ frontend/web/imgs/$1 [L]
RewriteRule ^viewss/(.*)$ frontend/web/viewss/$1 [L]

# 2. Arahkan root ke indexs.php
RewriteRule ^$ frontend/web/indexs.php [L]

# 3. Routing dinamis
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ frontend/web/indexs.php?urls=$1 [QSA,L]
