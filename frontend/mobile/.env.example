# Konfigurasi Lingkungan Aplikasi Mobile Lentera (Flutter)
# Salin berkas ini menjadi .env jika menggunakan flutter_dotenv atau sesuaikan pada lib/config/app_config.dart

# Alamat Server Backend API:
# - Emulator Android Bawaan (Android Studio): http://10.0.2.2/lentera/backend/api
# - Emulator Genymotion: http://10.0.3.2/lentera/backend/api
# - Perangkat Fisik (Smartphone via Wi-Fi): http://IP_LAN_KOMPUTER/lentera/backend/api (contoh: http://192.168.1.10/lentera/backend/api)
# - Simulator iOS (Mac): http://localhost/lentera/backend/api
API_BASE_URL=http://10.0.2.2/lentera/backend/api

# Batas Waktu Koneksi (Detik)
API_TIMEOUT_SECONDS=15

