# LENTERA — Environment Configuration
# Salin file ini menjadi .env dan sesuaikan nilainya

# ── Database ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_lentera
DB_USER=root
DB_PASS=

# ── Application ──
APP_NAME=lentera
APP_URL=http://localhost/lentera
APP_ENV=development
APP_DEBUG=true

# ── Session ──
SESSION_LIFETIME=30
SESSION_NAME=lentera_session

# ── Upload ──
UPLOAD_MAX_SIZE=20971520
UPLOAD_ALLOWED_TYPES=pdf
UPLOAD_PATH=../../uploads

# ── Email (untuk reset password) ──
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@lentera.unira.ac.id
MAIL_FROM_NAME=LENTERA UNIRA
