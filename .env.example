# LENTERA — Konfigurasi Lingkungan Aplikasi
# Salin file ini menjadi .env dan sesuaikan nilai konfigurasinya

# ── Konfigurasi Basis Data (MySQL) ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_lentera
DB_USER=root
DB_PASS=

# ── Konfigurasi Aplikasi ──
APP_NAME=lentera
APP_URL=http://localhost/lentera
APP_ENV=development
APP_DEBUG=true

# ── Konfigurasi Sesi ──
SESSION_LIFETIME=30
SESSION_NAME=lentera_session

# ── Konfigurasi Upload Berkas ──
UPLOAD_MAX_SIZE=20971520
UPLOAD_ALLOWED_TYPES=pdf
UPLOAD_PATH=uploads

# ── Konfigurasi Mail (Opsional) ──
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@lentera.unira.ac.id
MAIL_FROM_NAME="LENTERA UNIRA"
