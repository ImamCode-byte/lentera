@startuml
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam shadowing false
skinparam monochrome false

skinparam rectangle {
    BackgroundColor #FAFAFA
    BorderColor #333333
}

skinparam usecase {
    BackgroundColor #E8F0FE
    BorderColor #1A73E8
    ArrowColor #202124
}

title Sistem Repositori Karya Ilmiah Terpadu Akademik — LENTERA UNIRA (32 Use Cases)

left to right direction

actor "Publik (Guest)" as Guest
actor "Penulis (Author)" as Author
actor "Kurator (Curator)" as Curator
actor "Super Admin" as Admin

rectangle "Sistem LENTERA" {

  ' ==========================================
  ' 1. Use Cases Publik / Tamu (UC-01 s.d. UC-08)
  ' ==========================================
  usecase "UC-01: Menjelajah Beranda & Katalog Baru" as UC01
  usecase "UC-02: Mencari Naskah via Kata Kunci" as UC02
  usecase "UC-03: Menyaring Naskah per Fakultas & Prodi" as UC03
  usecase "UC-04: Menyaring per Tipe Dokumen & Tahun" as UC04
  usecase "UC-05: Melihat Detail Naskah & Abstrak" as UC05
  usecase "UC-06: Menggunakan Generator Sitasi Otomatis" as UC06
  usecase "UC-07: Mengunduh Berkas PDF Resmi" as UC07
  usecase "UC-08: Melihat Visualisasi Statistik Chart.js" as UC08

  ' ==========================================
  ' 2. Use Cases Penulis / Author (UC-09 s.d. UC-17)
  ' ==========================================
  usecase "UC-09: Mendaftar Akun Penulis Baru" as UC09
  usecase "UC-10: Masuk ke Akun (Login)" as UC10
  usecase "UC-11: Mengakses Dasbor Karya Penulis" as UC11
  usecase "UC-12: Mengunggah Naskah Ilmiah Baru" as UC12
  usecase "UC-13: Membaca Catatan Evaluasi Kurator" as UC13
  usecase "UC-14: Mengunggah Dokumen Revisi Berversi" as UC14
  usecase "UC-15: Mengakses Panduan Pembayaran APC" as UC15
  usecase "UC-16: Mengunggah Bukti Struk Bayar APC" as UC16
  usecase "UC-17: Keluar Sesi (Logout Aman)" as UC17

  ' ==========================================
  ' 3. Use Cases Dewan Kurator (UC-18 s.d. UC-25)
  ' ==========================================
  usecase "UC-18: Mengakses Antrean Kurasi Naskah" as UC18
  usecase "UC-19: Memeriksa Indeks Kemiripan (Similarity)" as UC19
  usecase "UC-20: Membuka & Menelaah Galley PDF" as UC20
  usecase "UC-21: Menandai Status Naskah In Review" as UC21
  usecase "UC-22: Memberikan Catatan & Minta Revisi" as UC22
  usecase "UC-23: Menyetujui Mutu Naskah (Approve)" as UC23
  usecase "UC-24: Menolak Naskah Ilmiah (Reject)" as UC24
  usecase "UC-25: Melihat Riwayat Keputusan Kurasi" as UC25

  ' ==========================================
  ' 4. Use Cases Super Admin (UC-26 s.d. UC-32)
  ' ==========================================
  usecase "UC-26: Mengakses Panel Kontrol Super Admin" as UC26
  usecase "UC-27: Verifikasi Struk APC & Terbitkan Karya" as UC27
  usecase "UC-28: Menolak Bukti Bayar APC Tidak Valid" as UC28
  usecase "UC-29: Mengelola Data Pengguna & Hak Akses" as UC29
  usecase "UC-30: Mengelola Master Fakultas & Prodi" as UC30
  usecase "UC-31: Memantau Audit Log Unduhan & Aktivitas" as UC31
  usecase "UC-32: Mengakses Rekapitulasi Borang Akreditasi" as UC32

  ' Relasi Antar Use Case
  UC05 .> UC06 : <<include>>
  UC07 .> UC05 : <<depends on>>
  UC14 .> UC13 : <<depends on>>
  UC16 .> UC15 : <<include>>
  UC22 .> UC20 : <<extend>>
  UC23 .> UC20 : <<extend>>
  UC24 .> UC20 : <<extend>>
  UC28 .> UC27 : <<extend>>
}

' Relasi Aktor Publik
Guest --> UC01
Guest --> UC02
Guest --> UC03
Guest --> UC04
Guest --> UC05
Guest --> UC07
Guest --> UC08
Guest --> UC09

' Relasi Aktor Penulis
Author --> UC10
Author --> UC11
Author --> UC12
Author --> UC13
Author --> UC14
Author --> UC15
Author --> UC16
Author --> UC17

' Relasi Aktor Kurator
Curator --> UC10
Curator --> UC18
Curator --> UC19
Curator --> UC20
Curator --> UC21
Curator --> UC22
Curator --> UC23
Curator --> UC24
Curator --> UC25
Curator --> UC17

' Relasi Aktor Admin
Admin --> UC10
Admin --> UC26
Admin --> UC27
Admin --> UC28
Admin --> UC29
Admin --> UC30
Admin --> UC31
Admin --> UC32
Admin --> UC18
Admin --> UC17

@enduml
