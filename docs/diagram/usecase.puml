@startuml
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam shadowing false
skinparam monochrome false

title Sistem Repositori Karya Ilmiah Terpadu Akademik — LENTERA UNIRA

left to right direction

actor "Publik (Guest)" as Guest
actor "Penulis (Author)" as Author
actor "Kurator (Curator)" as Curator
actor "Super Admin" as Admin

rectangle "Sistem LENTERA" {

  ' Use Cases Publik
  usecase "UC-01: Melihat Beranda & Metrik Koleksi" as UC01
  usecase "UC-02: Mencari Naskah via Kata Kunci/Penulis" as UC02
  usecase "UC-03: Menyaring Naskah per Fakultas" as UC03
  usecase "UC-05: Melihat Detail Naskah & Abstrak" as UC05
  usecase "UC-06: Menggunakan Generator Sitasi" as UC06
  usecase "UC-07: Mengunduh Berkas PDF Resmi" as UC07
  usecase "UC-08: Mendaftar Akun Penulis Baru" as UC08

  ' Use Cases Penulis
  usecase "UC-09: Masuk ke Akun (Login)" as UC09
  usecase "UC-10: Mengakses Dasbor Karya Saya" as UC10
  usecase "UC-11: Mengunggah Naskah Ilmiah Baru" as UC11
  usecase "UC-12: Memantau Catatan Telaah Kurator" as UC12
  usecase "UC-13: Mengunggah Berkas Revisi Naskah" as UC13
  usecase "UC-14: Mengakses Pembayaran APC" as UC14
  usecase "UC-15: Konfirmasi Pelunasan Publikasi" as UC15
  usecase "UC-17: Keluar Sesi (Logout)" as UC17

  ' Use Cases Kurator
  usecase "UC-19: Mengakses Dasbor Kurasi Naskah" as UC19
  usecase "UC-20: Memeriksa Berkas Naskah Masuk" as UC20
  usecase "UC-21: Menandai Naskah In Review" as UC21
  usecase "UC-22: Memberikan Catatan Telaah & Minta Revisi" as UC22
  usecase "UC-23: Menyetujui Publikasi (Approve)" as UC23
  usecase "UC-24: Menolak Naskah Ilmiah (Reject)" as UC24
  usecase "UC-25: Mengalihkan ke Waiting Payment" as UC25
  usecase "UC-27: Melihat Riwayat Keputusan Kurasi" as UC27

  ' Use Cases Admin
  usecase "UC-28: Mengelola Data Pengguna & Hak Akses" as UC28
  usecase "UC-29: Mengelola Master Fakultas & Prodi" as UC29
  usecase "UC-30: Memantau Audit Log & Analitik" as UC30

  ' Relasi Include & Extend
  UC05 .> UC06 : <<include>>
  UC07 .> UC05 : <<depends on>>
  UC13 .> UC12 : <<depends on>>
  UC22 .> UC20 : <<extend>>
  UC23 .> UC20 : <<extend>>
  UC24 .> UC20 : <<extend>>
  UC25 .> UC20 : <<extend>>
}

' Relasi Aktor Publik
Guest --> UC01
Guest --> UC02
Guest --> UC03
Guest --> UC05
Guest --> UC07
Guest --> UC08

' Relasi Aktor Penulis
Author --> UC09
Author --> UC10
Author --> UC11
Author --> UC12
Author --> UC13
Author --> UC14
Author --> UC15
Author --> UC17

' Relasi Aktor Kurator
Curator --> UC09
Curator --> UC19
Curator --> UC20
Curator --> UC21
Curator --> UC22
Curator --> UC23
Curator --> UC24
Curator --> UC25
Curator --> UC27
Curator --> UC17

' Relasi Aktor Admin
Admin --> UC09
Admin --> UC28
Admin --> UC29
Admin --> UC30
Admin --> UC19
Admin --> UC17

@enduml
